#!/usr/bin/env bash
#
# Add call transcripts and rebuild the affected context graph(s).
#
#   ./add-transcripts ~/Downloads/new_calls          add them, auto-routing per client
#   CLIENT=acme ./add-transcripts ~/Downloads/calls  force every file to one client
#   ./add-transcripts ~/Downloads/calls --replace    make them a client's ENTIRE set
#
# Two things worth knowing about the design:
#
#  * It ADDS by default. run_client.py replaces a client's transcript set unless
#    told otherwise, which would silently discard everything already loaded.
#
#  * Each file is routed INDIVIDUALLY. A single vote for the whole folder is wrong
#    as soon as a folder holds two clients' calls — a real 165-file drop was 112
#    ABCL + 52 Myntra + 1 voicemail, and one vote filed all 165 under Myntra.
#
# Written for bash 3.2 (what macOS ships): no mapfile, no associative arrays.

set -euo pipefail
cd "$(dirname "$0")"

BOLD=$'\033[1m'; GREEN=$'\033[1;32m'; RED=$'\033[1;31m'
YELLOW=$'\033[1;33m'; DIM=$'\033[2m'; OFF=$'\033[0m'
die() { printf '\n%s✗ %s%s\n\n' "$RED" "$1" "$OFF" >&2; exit 1; }

[ $# -ge 1 ] || die "usage: ./add-transcripts <folder-of-transcripts> [--replace]"

SRC="$1"
# Same stray-quote tolerance as ./improve — see the note there.
SRC="${SRC#[\'\"]}"; SRC="${SRC%[\'\"]}"
SRC="${SRC/#\~/$HOME}"
MODE="append"
[ "${2:-}" = "--replace" ] && MODE="replace"
[ -d "$SRC" ] || die "not a folder: $SRC"

[ -d .venv ] && . .venv/bin/activate

N_IN=$(find "$SRC" -maxdepth 1 -type f \( -name '*.txt' -o -name '*.json' \) | wc -l | tr -d ' ')
[ "$N_IN" -gt 0 ] || die "no .txt or .json transcripts directly inside $SRC"

FOLDER_SLUG=$(basename "$SRC" | tr '[:upper:] ' '[:lower:]_' | tr -cd 'a-z0-9_-')
SPLIT_DIR=$(mktemp -d)
ROUTES=$(mktemp)
trap 'rm -rf "$SPLIT_DIR" "$ROUTES"' EXIT

printf '\n%sRouting %s transcript(s)%s from %s\n\n' "$BOLD" "$N_IN" "$OFF" "$SRC"

# --- split the input by detected client --------------------------------------
python3 - "$SRC" "$SPLIT_DIR" "$FOLDER_SLUG" "${CLIENT:-}" "$ROUTES" <<'PY'
import pathlib, shutil, sys
from src import clients

src, split, folder_slug, forced, routes = (
    pathlib.Path(sys.argv[1]), pathlib.Path(sys.argv[2]),
    sys.argv[3], sys.argv[4], pathlib.Path(sys.argv[5]))

files = sorted(p for p in src.iterdir() if p.suffix in (".txt", ".json"))
groups = {}
skipped = 0


def _content_hashes(client_key):
    """Hashes of what this client already holds. Filenames cannot be trusted for
    identity: a re-exported call arrives under a fresh UUID, and appending a folder
    twice silently doubled Myntra's corpus (52 real calls presented as 104) which
    would quietly skew every rate the graph reports."""
    import hashlib
    d = pathlib.Path("data/clients") / client_key / "transcripts"
    seen = set()
    if d.is_dir():
        for q in d.iterdir():
            if q.is_file():
                seen.add(hashlib.sha1(q.read_bytes()).hexdigest())
    return seen


import hashlib

# Classify first, decide what to do with the unidentifiable ones second.
assigned, unknown = [], []
for p in files:
    if forced:
        assigned.append((forced, p))
        continue
    c = clients.detect_client_for_path(p)
    (assigned.append((c.key, p)) if c else unknown.append(p))

# An unmatched file means "cannot tell whose this is" — which is only evidence of a
# NEW client when that is what the whole drop looks like. A couple of strays among
# recognized calls are usually voicemail or a failed recording, and minting a client
# for them litters data/clients/ with junk (verified: one voicemail created an
# "abcl_new" client with a graph of a single call).
mostly_unknown = unknown and len(unknown) >= max(2, len(files) * 0.5)
if mostly_unknown:
    assigned += [(folder_slug, p) for p in unknown]
    unknown = []

_existing = {}
for key, p in assigned:
    if key not in _existing:
        _existing[key] = _content_hashes(key)
    h = hashlib.sha1(p.read_bytes()).hexdigest()
    if h in _existing[key]:
        skipped += 1
        continue
    _existing[key].add(h)      # also de-dupes repeats within this drop
    groups.setdefault(key, []).append(p)

for key, ps in groups.items():
    d = split / key
    d.mkdir(parents=True, exist_ok=True)
    for p in ps:
        shutil.copy2(p, d / p.name)

known = {c.key for c in clients.get_known_clients()}
with routes.open("w") as fh:
    for key, ps in sorted(groups.items(), key=lambda kv: -len(kv[1])):
        fh.write(f"{key}\t{len(ps)}\t{'known' if key in known else 'new'}\n")
if skipped:
    print(f"  \033[2m{skipped} file(s) skipped — identical content already loaded\033[0m")
if unknown:
    print(f"  \033[1;33m{len(unknown)} file(s) NOT loaded\033[0m — could not tell which client "
          f"they belong to:")
    for p in unknown[:5]:
        print(f"      {p.name}")
    if len(unknown) > 5:
        print(f"      … and {len(unknown) - 5} more")
    print("  \033[2mIf these do belong to a client, re-run as: "
          "CLIENT=<key> ./add-transcripts <folder>\033[0m")
PY

while IFS=$'\t' read -r key n kind; do
  if [ "$kind" = "known" ]; then
    printf '  %s%-22s%s %4s file(s)  %s(existing client)%s\n' "$BOLD" "$key" "$OFF" "$n" "$DIM" "$OFF"
  else
    printf '  %s%-22s%s %4s file(s)  %s(NEW client — matched no known signature)%s\n' \
      "$YELLOW" "$key" "$OFF" "$n" "$DIM" "$OFF"
  fi
done < "$ROUTES"
echo

if [ "$MODE" = "replace" ]; then
  printf '  %s! --replace will DISCARD what these clients already have.%s\n' "$RED" "$OFF"
  printf '  Press enter to continue, Ctrl-C to stop. '
  read -r _
fi

# --- ingest each group into its own client -----------------------------------
while IFS=$'\t' read -r key n kind; do
  BEFORE=0
  [ -d "data/clients/$key/transcripts" ] && \
    BEFORE=$(find "data/clients/$key/transcripts" -type f | wc -l | tr -d ' ')

  FLAGS="--client $key"
  [ "$MODE" = "append" ] && FLAGS="$FLAGS --append"

  set +e
  # shellcheck disable=SC2086
  python run_client.py "$SPLIT_DIR/$key" $FLAGS > "/tmp/add-$key.log" 2>&1
  rc=$?
  set -e
  if [ $rc -ne 0 ]; then
    tail -15 "/tmp/add-$key.log" >&2
    die "ingest failed for '$key' — full log: /tmp/add-$key.log"
  fi

  AFTER=$(find "data/clients/$key/transcripts" -type f | wc -l | tr -d ' ')
  printf '  %s✓%s %-22s %s -> %s transcript(s)   graph: data/output/%s_output/\n' \
    "$GREEN" "$OFF" "$key" "$BEFORE" "$AFTER" "$key"
done < "$ROUTES"

printf '\n  Next: %s./improve "<path to that client'"'"'s prompt>"%s\n' "$BOLD" "$OFF"
printf '  %s(the client is auto-detected from the prompt too)%s\n\n' "$DIM" "$OFF"
