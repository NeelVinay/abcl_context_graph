.venv/
.DS_Store
**/.DS_Store

# LLM response cache + call log: machine-local derived data, never source.
# Committing the cache would be actively harmful — src/llm.py keys it on
# sha1(prompt), so a checked-in cache silently serves someone else's stale
# answers instead of calling the API, and the run would look like it worked.
platform/data/clients/*/llm_cache.json
platform/data/clients/*/llm_calls.jsonl

# Per-run generated reports. Derived output, regenerated every run, and naming
# them per-prompt means an unbounded set of files — the committed worked example
# lives in platform/data/clients/<client>/autorun/ instead.
platform/data/clients/*/CHANGES-*.md
platform/data/clients/*/review_queue-*.md
platform/data/clients/*/*.bak

# Fully-rendered prompts sent to the API, with the responses. Written for
# auditability (they carry ~97 verbatim customer turns and their call IDs), and
# gitignored for exactly that reason — same treatment as transcripts/.
platform/data/clients/*/prompts_sent/

# ./bin/run-pipeline's output — always fully rebuilt, never source. See COMMANDS.md.
deliverables/
platform/data/clients/*/.work/

# intake/ is a staging copy, not a second source of truth. The real, tracked
# transcript store is platform/data/clients/<client>/transcripts/ (populated and
# kept in sync by ./bin/load-transcripts / ./bin/load-prompt on every run) —
# committing intake/ too meant every real customer transcript was duplicated in
# the repo. Keep the folders themselves present via .gitkeep so a fresh clone
# still has somewhere to drop files.
intake/transcripts/*
intake/prompt/*
!intake/transcripts/.gitkeep
!intake/prompt/.gitkeep

# ./platform/improve's own throwaway test output (advanced/testing tool only).
platform/test-output/

# ./platform/reset's archive of whatever it wiped. Local safety net, not a
# fixture — potentially contains real transcripts, so must never be pushed.
platform/data/.reset-archive/

# Internal per-client working area, regenerated by every run_client.py /
# ./bin/run-pipeline call — the active client's result is what ends up in
# deliverables/Context_Graph/, so this is never a second source of truth.
# Confirmed never tracked before this restructure (git log across all
# history shows zero commits touching it); a blanket `git add -A` during the
# platform/ rename nearly committed it for the first time by accident.
platform/data/output/

# Old, pre-run_client.py demo output (original/, txt/, mp3/, test_100_sop*/,
# generic_raw/) kept on disk for provenance but likewise never tracked —
# same accidental-inclusion risk as data/output/ above. data/archive/test_100/
# (the raw transcripts, not this output/ subfolder) IS tracked and stays that way.
platform/data/archive/output/
