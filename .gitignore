.venv/
.DS_Store
**/.DS_Store

# LLM response cache + call log: machine-local derived data, never source.
# Committing the cache would be actively harmful — src/llm.py keys it on
# sha1(prompt), so a checked-in cache silently serves someone else's stale
# answers instead of calling the API, and the run would look like it worked.
engine/data/clients/*/llm_cache.json
engine/data/clients/*/llm_calls.jsonl

# Per-run generated reports. Derived output, regenerated every run, and naming
# them per-prompt means an unbounded set of files — the committed worked example
# lives in engine/data/clients/<client>/autorun/ instead.
engine/data/clients/*/CHANGES-*.md
engine/data/clients/*/review_queue-*.md
engine/data/clients/*/*.bak

# Fully-rendered prompts sent to the API, with the responses. Written for
# auditability (they carry ~97 verbatim customer turns and their call IDs), and
# gitignored for exactly that reason — same treatment as transcripts/.
engine/data/clients/*/prompts_sent/

# ./run-pipeline's output — always fully rebuilt, never source. See commands.md.
OUTPUT/
engine/data/clients/*/.work/

# ./engine/improve's own throwaway test output (advanced/testing tool only).
engine/test-output/

# ./engine/reset's archive of whatever it wiped. Local safety net, not a
# fixture — potentially contains real transcripts, so must never be pushed.
engine/data/.reset-archive/
