#!/usr/bin/env bash
#
# Wipe ALL derived state for a client, back to true zero — for proving the
# pipeline regenerates itself end-to-end, live, with nothing cached or hidden.
#
#   ./reset abcl
#
# Everything is ARCHIVED first (moved, not destroyed), so this is reversible.
# The archive location is printed at the end.
#
# What "true zero" means here, specifically: no transcripts, no context graph,
# no cached call extractions for this client (including ones from OLDER runs
# that don't live in the current transcripts/ folder — see the note in DEMO.md
# about why that matters), no LLM response cache, no call log, no audit trail
# of prompts sent, no generated CHANGES/review files, no leftover OUTPUT/.

set -euo pipefail
cd "$(dirname "$0")"

BOLD=$'\033[1m'; GREEN=$'\033[1;32m'; RED=$'\033[1;31m'; DIM=$'\033[2m'; OFF=$'\033[0m'
die() { printf '\n%s✗ %s%s\n\n' "$RED" "$1" "$OFF" >&2; exit 1; }

[ $# -eq 1 ] || die "usage: ./reset <client-key>   e.g. ./reset abcl"
CLIENT="$1"
CDIR="data/clients/$CLIENT"
[ -d "$CDIR" ] || die "no such client: $CDIR does not exist"

[ -d .venv ] && . .venv/bin/activate

STAMP=$(date +%Y%m%d-%H%M%S)
ARCHIVE="data/.reset-archive/${CLIENT}-${STAMP}"
mkdir -p "$ARCHIVE"

printf '\n%sResetting %s%s to zero.%s\n' "$BOLD" "$CLIENT" "$OFF" "$DIM"
printf 'Everything below is moved to %s, not deleted.%s\n\n' "$ARCHIVE" "$OFF"

# Capture which call_ids belong to this client BEFORE anything moves, so their
# cache entries (data/cache/<call_id>.json — a directory shared across every
# client) can be found and archived too. Cache is looked up by call_id, not by
# client, so a transcript's cached extraction does not live next to it.
BEFORE_IDS=$(mktemp)
if [ -d "$CDIR/transcripts" ]; then
  find "$CDIR/transcripts" -type f \( -name '*.txt' -o -name '*.json' \) \
    -exec basename {} \; | sed -E 's/\.(txt|json)$//' > "$BEFORE_IDS"
fi
N_TRANSCRIPTS=$(wc -l < "$BEFORE_IDS" | tr -d ' ')

move() {  # move <src> <label>
  local src="$1" label="$2"
  if [ -e "$src" ]; then
    mkdir -p "$(dirname "$ARCHIVE/$src")"
    mv "$src" "$ARCHIVE/$src"
    printf '  %s✓%s %-38s archived\n' "$GREEN" "$OFF" "$label"
  else
    printf '  %s·%s %-38s already absent\n' "$DIM" "$OFF" "$label"
  fi
}

move "$CDIR/transcripts"                 "transcripts ($N_TRANSCRIPTS files)"
move "data/output/${CLIENT}_output"      "context graph"
move "$CDIR/llm_cache.json"              "LLM response cache"
move "$CDIR/llm_calls.jsonl"             "LLM call log"
move "$CDIR/prompts_sent"                "audit trail of prompts sent to the LLM"
move "$CDIR/.work"                       "scratch state"
move "$CDIR/anchor_decisions.json"       "old anchor review decisions"
# NOT autorun/ — that is the project's COMMITTED reference example (see
# README.md and .gitignore's comment on it), not disposable demo output. A
# prior version of this script archived it by mistake; restored from git.

# CHANGES-*.md / review_queue-*.md are per-run outputs, filenames vary.
shopt -s nullglob
for f in "$CDIR"/CHANGES-*.md "$CDIR"/review_queue-*.md; do
  move "$f" "$(basename "$f")"
done
shopt -u nullglob

move "OUTPUT" "top-level OUTPUT/ folder"

# Cache entries for this client's call_ids, wherever the file physically lives
# (data/cache is shared across clients — see the module docstring above).
N_CACHE=0
if [ -s "$BEFORE_IDS" ]; then
  mkdir -p "$ARCHIVE/data/cache"
  while IFS= read -r cid; do
    f="data/cache/${cid}.json"
    if [ -f "$f" ]; then
      mv "$f" "$ARCHIVE/$f"
      N_CACHE=$((N_CACHE + 1))
    fi
  done < "$BEFORE_IDS"
fi
printf '  %s✓%s %-38s archived\n' "$GREEN" "$OFF" "cached call extractions ($N_CACHE files)"
rm -f "$BEFORE_IDS"

# --- verify true zero -----------------------------------------------------
echo
python3 - "$CLIENT" <<'PY'
import sys
from src import dsl_audit
client = sys.argv[1]
calls = dsl_audit._client_calls(client)
if calls:
    print(f"  \033[1;31m! {len(calls)} call(s) STILL attributed to '{client}'\033[0m — "
          f"orphaned cache entries elsewhere are being swept in. Not a true zero yet.")
    for c in calls[:5]:
        print(f"      {c.get('call_id','?')}")
else:
    print("  \033[1;32m✓ verified: zero calls attributed to this client — a genuine clean slate\033[0m")
PY

printf '\n%s%s is now empty.%s Archive kept at: %s%s%s\n' "$BOLD" "$CLIENT" "$OFF" "$DIM" "$ARCHIVE" "$OFF"
printf '\n  Next, live:\n'
printf '    %s./add-transcripts <folder of transcripts>%s   builds the client + context graph\n' "$BOLD" "$OFF"
printf '    %s./improve '"'"'<path to the prompt>'"'"'%s              analyzes it and improves the prompt\n\n' "$BOLD" "$OFF"
