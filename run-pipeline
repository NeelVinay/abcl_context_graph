#!/usr/bin/env bash
#
# Run everything, start to finish: load transcripts -> build the context graph
# -> analyze it -> improve the prompt. One command, one output folder.
#
#   ./run-pipeline
#
# Reads from INPUT/transcripts/ and INPUT/prompt/. Writes everything to OUTPUT/,
# which is fully rebuilt on every run — always reflects only the latest input,
# never a mix of old and new. Neither INPUT/ file is ever modified.
#
# Uses the local Claude Code CLI — no API key needed. First run against a given
# prompt+transcript combination makes live model calls (a few minutes); re-running
# the same inputs is near-instant, since decisions are cached on their content.

set -euo pipefail
cd "$(dirname "$0")"
ROOT="$PWD"
ENGINE="$ROOT/engine"

BOLD=$'\033[1m'; CYAN=$'\033[1;36m'; GREEN=$'\033[1;32m'
RED=$'\033[1;31m'; DIM=$'\033[2m'; OFF=$'\033[0m'
die() { printf '\n%s✗ %s%s\n\n' "$RED" "$1" "$OFF" >&2; exit 1; }
step() { printf '\n%s━━━ %s ━━━%s\n' "$CYAN" "$1" "$OFF"; }

NOISE='RuntimeWarning|ret = a @ b|Orthogonal edges do not currently handle|NotOpenSSLWarning|warnings\.warn|^ *$'

[ -d "$ROOT/.venv" ] && . "$ROOT/.venv/bin/activate"

# --------------------------------------------------------------- 0. preflight
step "0/3  Preflight"

N_T=$(find "$ROOT/INPUT/transcripts" -maxdepth 1 -type f \( -name '*.txt' -o -name '*.json' \) 2>/dev/null | wc -l | tr -d ' ')
[ "$N_T" -gt 0 ] || die "INPUT/transcripts/ is empty — run ./load-transcripts first."
printf '   %s✓%s transcripts: %s file(s) in INPUT/transcripts/\n' "$GREEN" "$OFF" "$N_T"

N_P=$(find "$ROOT/INPUT/prompt" -maxdepth 1 -type f ! -name '.*' 2>/dev/null | wc -l | tr -d ' ')
[ "$N_P" -gt 0 ] || die "INPUT/prompt/ is empty — run ./load-prompt first."
[ "$N_P" -eq 1 ] || die "INPUT/prompt/ has $N_P files — keep exactly one."
PROMPT=$(find "$ROOT/INPUT/prompt" -maxdepth 1 -type f ! -name '.*')
printf '   %s✓%s prompt: %s\n' "$GREEN" "$OFF" "$(basename "$PROMPT")"

CLIENT=$(cd "$ENGINE" && python3 - "$PROMPT" <<'PY'
import pathlib, sys
from src import clients
c = clients.detect_client_for_path(pathlib.Path(sys.argv[1]))
print(c.key if c else "")
PY
)
[ -n "$CLIENT" ] || die "could not tell which client this prompt belongs to."
printf '   %s✓%s client: %s\n' "$GREEN" "$OFF" "$CLIENT"

PROVIDER=$(cd "$ENGINE" && python3 -c 'from src import llm; print(llm.resolve_provider())') \
  || die "no LLM backend available — set ANTHROPIC_API_KEY, or install Claude Code."
printf '   %s✓%s LLM backend: %s\n' "$GREEN" "$OFF" "$PROVIDER"

WORK="$ENGINE/data/clients/$CLIENT/.work"
rm -rf "$WORK" "$ROOT/OUTPUT"
mkdir -p "$WORK"

# ------------------------------------------------------ 1. load + build graph
step "1/3  Context graph  ($N_T transcripts -> $CLIENT)"

(cd "$ENGINE" && python3 - "$CLIENT" "$ROOT/INPUT/transcripts" <<'PY'
import sys
from pathlib import Path
from run_client import sync_transcripts, _client_by_key_or_new
client = _client_by_key_or_new(sys.argv[1])
sync_transcripts(client, Path(sys.argv[2]), append=False)
PY
)

set +e
(cd "$ENGINE" && python run_client.py "$ROOT/INPUT/transcripts" --client "$CLIENT") \
  > "$WORK/1-graph.log" 2>&1
rc=$?
set -e
grep -vE "$NOISE" "$WORK/1-graph.log" | sed 's/^/   /' || true
[ $rc -eq 0 ] || die "graph build failed — see $WORK/1-graph.log"

# --------------------------------------------------------- 2. improve prompt
step "2/3  Prompt improvement"

cp "$PROMPT" "$WORK/improved.raven"
CALL_LOG="$ENGINE/data/clients/$CLIENT/llm_calls.jsonl"
OFFSET=0
[ -f "$CALL_LOG" ] && OFFSET=$(wc -l < "$CALL_LOG" | tr -d ' ')

set +e
python "$ENGINE/run_improve.py" "$WORK/improved.raven" --client "$CLIENT" --auto \
  2>&1 | tee "$WORK/2-improve.log"
rc=${PIPESTATUS[0]}
set -e
[ $rc -eq 0 ] || die "improvement failed — see $WORK/2-improve.log"

# ------------------------------------------------------- 3. assemble OUTPUT/
step "3/3  Writing OUTPUT/"

mkdir -p "$ROOT/OUTPUT/Context_Graph"
cp "$PROMPT"                    "$ROOT/OUTPUT/Original_Prompt.raven"
cp "$WORK/improved.raven"       "$ROOT/OUTPUT/Improved_Prompt.raven"
diff -u "$ROOT/OUTPUT/Original_Prompt.raven" "$ROOT/OUTPUT/Improved_Prompt.raven" \
  > "$ROOT/OUTPUT/Changes.diff" || true
CH="$ENGINE/data/clients/$CLIENT/CHANGES-improved.md"
[ -f "$CH" ] && cp "$CH" "$ROOT/OUTPUT/Change_Rationale.md"
cp "$WORK/2-improve.log"        "$ROOT/OUTPUT/Run_Log.txt"

GDIR="$ENGINE/data/output/${CLIENT}_output"
[ -f "$GDIR/${CLIENT}_exec.png" ] && cp "$GDIR/${CLIENT}_exec.png" "$ROOT/OUTPUT/Context_Graph/Context_Graph.png"
[ -f "$GDIR/report.md" ]          && cp "$GDIR/report.md"          "$ROOT/OUTPUT/Context_Graph/Report.md"
[ -f "$GDIR/turns.md" ]           && cp "$GDIR/turns.md"           "$ROOT/OUTPUT/Context_Graph/Turns.md"
[ -f "$GDIR/intents.md" ]         && cp "$GDIR/intents.md"         "$ROOT/OUTPUT/Context_Graph/Intent_Glossary.md"

ADDED=$(grep -c '^+[^+]' "$ROOT/OUTPUT/Changes.diff" || true)
python3 - "$CALL_LOG" "$OFFSET" <<'PY'
import json, pathlib, sys
log, offset = pathlib.Path(sys.argv[1]), int(sys.argv[2])
rows = []
if log.exists():
    for line in log.read_text().splitlines()[offset:]:
        try: rows.append(json.loads(line))
        except Exception: pass
live = [r for r in rows if not r.get("cached")]
cached = len(rows) - len(live)
tin = sum(r.get("in_tokens", 0) for r in live)
tout = sum(r.get("out_tokens", 0) for r in live)
print(f"   LLM this run: {len(live)} live call(s), {cached} cache hit(s)")
if live:
    print(f"                 {tin:,} in / {tout:,} out tokens")
PY
printf '   lines added:   %s\n' "${ADDED:-0}"

printf '\n%s%s✓ Done.%s\n\n' "$GREEN" "$BOLD" "$OFF"
printf '  %sOUTPUT/Improved_Prompt.raven%s     <- paste this into NuPlay\n' "$BOLD" "$OFF"
printf '  OUTPUT/Change_Rationale.md      what changed and why\n'
printf '  OUTPUT/Changes.diff             before/after, line by line\n'
printf '  OUTPUT/Context_Graph/           the call-flow chart, report, glossary\n\n'

if command -v pbcopy >/dev/null 2>&1; then
  pbcopy < "$ROOT/OUTPUT/Improved_Prompt.raven"
  printf '  %s(Improved_Prompt.raven is on your clipboard)%s\n\n' "$DIM" "$OFF"
fi
