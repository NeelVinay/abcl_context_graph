#!/usr/bin/env bash
#
# Load the prompt to improve, from anywhere on your laptop, into intake/prompt/.
# Validates it and checks its client has transcripts loaded — does NOT run any
# analysis. That happens in ./bin/run-pipeline.
#
#   ./bin/load-prompt                       (re-)check the file already in intake/prompt/
#   ./bin/load-prompt ~/Downloads/x.raven   pull this file in, replacing whatever
#                                          was in intake/prompt/

set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(dirname "$SCRIPT_DIR")"          # this script lives in <repo root>/bin/
cd "$ROOT"
PLATFORM="$ROOT/platform"

BOLD=$'\033[1m'; GREEN=$'\033[1;32m'; RED=$'\033[1;31m'; YELLOW=$'\033[1;33m'; DIM=$'\033[2m'; OFF=$'\033[0m'
die() { printf '\n%s✗ %s%s\n\n' "$RED" "$1" "$OFF" >&2; exit 1; }

[ -d "$ROOT/.venv" ] && . "$ROOT/.venv/bin/activate"

SRC="${1:-}"
SRC="${SRC#[\'\"]}"; SRC="${SRC%[\'\"]}"
SRC="${SRC/#\~/$HOME}"

if [ -n "$SRC" ]; then
  [ -f "$SRC" ] || die "no such file: $SRC"
  rm -f "$ROOT/intake/prompt"/* 2>/dev/null
  cp "$SRC" "$ROOT/intake/prompt/$(basename "$SRC")"
  printf '\n%sPulled%s %s into intake/prompt/\n' "$BOLD" "$OFF" "$SRC"
fi

N=$(find "$ROOT/intake/prompt" -maxdepth 1 -type f ! -name '.*' | wc -l | tr -d ' ')
if [ "$N" -eq 0 ]; then
  die "intake/prompt/ is empty — pass the file to pull in:
      ./bin/load-prompt ~/Downloads/your_prompt.raven"
fi
if [ "$N" -gt 1 ]; then
  printf '\n%s✗ intake/prompt/ has %s files — keep exactly one.%s\n\n' "$RED" "$N" "$OFF" >&2
  find "$ROOT/intake/prompt" -maxdepth 1 -type f ! -name '.*' -exec basename {} \; | sed 's/^/    /' >&2
  exit 1
fi
PROMPT=$(find "$ROOT/intake/prompt" -maxdepth 1 -type f ! -name '.*')

printf '\n%sChecking:%s %s\n\n' "$BOLD" "$OFF" "$PROMPT"

(cd "$PLATFORM" && python3 - "$PROMPT" <<'PY'
import pathlib, sys
from src import clients, dsl_parse, dsl_audit

BOLD, GREEN, RED, YELLOW, DIM, OFF = (
    "\033[1m", "\033[1;32m", "\033[1;31m", "\033[1;33m", "\033[2m", "\033[0m")

p = pathlib.Path(sys.argv[1])
c = clients.detect_client_for_path(p)
if not c:
    print(f"{RED}✗ Could not tell which client this prompt belongs to{OFF} — "
          f"its text doesn't match a known client's signature.")
    sys.exit(1)
print(f"  {GREEN}✓{OFF} client: {BOLD}{c.key}{OFF}  ({c.label})")

# Rename to a clean, professional name now that the client is known — a pulled
# file otherwise keeps whatever name it arrived with (spaces, parentheses,
# "present prompt Tuesday 6_30 (1)"-style clutter).
clean_name = f"{c.key.upper()}_Prompt{p.suffix or '.raven'}"
clean = p.with_name(clean_name)
if p.name != clean_name:
    p.rename(clean)
    p = clean
    print(f"  {GREEN}✓{OFF} renamed to: {BOLD}{p.name}{OFF}")

try:
    d = dsl_parse.parse(str(p))
    print(f"  {GREEN}✓{OFF} parses cleanly: {len(d.intents)} intents, {len(d.states)} states")
except Exception as e:  # noqa: BLE001
    print(f"  {RED}✗ does not parse as valid .raven: {e}{OFF}")
    sys.exit(1)

calls = dsl_audit._client_calls(c.key)
if not calls:
    print(f"  {YELLOW}! no transcripts loaded for '{c.key}' yet{OFF} — run ./bin/load-transcripts first")
    sys.exit(1)
print(f"  {GREEN}✓{OFF} {len(calls)} transcript(s) already loaded for {c.key}")

print(f"\n  {BOLD}Ready.{OFF} Next: {BOLD}./bin/run-pipeline{OFF}\n")
PY
)
