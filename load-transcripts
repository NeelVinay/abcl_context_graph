#!/usr/bin/env bash
#
# Load call transcripts from anywhere on your laptop into INPUT/transcripts/,
# and register them for whichever client they belong to. Does NOT build the
# context graph or touch the prompt — that happens in ./run-pipeline.
#
#   ./load-transcripts                        (re-)register what's already in
#                                              INPUT/transcripts/
#   ./load-transcripts ~/Downloads/new_calls   pull from a folder anywhere else —
#                                              copies it into INPUT/transcripts/
#                                              first, then registers it
#   ./load-transcripts --append                add to what's loaded instead of
#                                              replacing it
#
# Replaces by default — this project works with one client's data at a time, so
# a fresh load is assumed to be the new active set, not an addition to the old one.
#
# Each file is routed to its client individually (a folder can hold more than one
# client's calls), de-duplicated by content, and a folder that matches no known
# client becomes a new one, named after itself.
#
# Written for bash 3.2 (what macOS ships): no mapfile, no associative arrays.

set -euo pipefail
cd "$(dirname "$0")"
ROOT="$PWD"
ENGINE="$ROOT/engine"

BOLD=$'\033[1m'; GREEN=$'\033[1;32m'; RED=$'\033[1;31m'
YELLOW=$'\033[1;33m'; DIM=$'\033[2m'; OFF=$'\033[0m'
die() { printf '\n%s✗ %s%s\n\n' "$RED" "$1" "$OFF" >&2; exit 1; }

ARG="${1:-}"
[ "$ARG" = "--append" ] && ARG=""
ARG="${ARG#[\'\"]}"; ARG="${ARG%[\'\"]}"
ARG="${ARG/#\~/$HOME}"
MODE="replace"
[ "${1:-}" = "--append" ] || [ "${2:-}" = "--append" ] && MODE="append"

[ -d "$ROOT/.venv" ] && . "$ROOT/.venv/bin/activate"

# --- pull from an external folder into INPUT/transcripts/ first, if one was given
if [ -n "$ARG" ]; then
  [ -d "$ARG" ] || die "not a folder: $ARG"
  N_PULL=$(find "$ARG" -maxdepth 1 -type f \( -name '*.txt' -o -name '*.json' \) | wc -l | tr -d ' ')
  [ "$N_PULL" -gt 0 ] || die "no .txt or .json transcripts directly inside $ARG"
  [ "$MODE" = "replace" ] && rm -f "$ROOT/INPUT/transcripts"/*.txt "$ROOT/INPUT/transcripts"/*.json 2>/dev/null
  cp "$ARG"/*.txt "$ROOT/INPUT/transcripts/" 2>/dev/null || true
  cp "$ARG"/*.json "$ROOT/INPUT/transcripts/" 2>/dev/null || true
  printf '\n%sPulled %s file(s)%s from %s into INPUT/transcripts/\n' "$BOLD" "$N_PULL" "$OFF" "$ARG"
fi

SRC="$ROOT/INPUT/transcripts"
N_IN=$(find "$SRC" -maxdepth 1 -type f \( -name '*.txt' -o -name '*.json' \) | wc -l | tr -d ' ')
[ "$N_IN" -gt 0 ] || die "INPUT/transcripts/ is empty — pass a folder to pull from:
      ./load-transcripts ~/Downloads/your_calls"

FOLDER_SLUG="transcripts"
SPLIT_DIR=$(mktemp -d)
ROUTES=$(mktemp)
trap 'rm -rf "$SPLIT_DIR" "$ROUTES"' EXIT

printf '\n%sRegistering %s transcript(s)%s from INPUT/transcripts/\n\n' "$BOLD" "$N_IN" "$OFF"

# --- split the input by detected client --------------------------------------
(cd "$ENGINE" && python3 - "$SRC" "$SPLIT_DIR" "$FOLDER_SLUG" "${CLIENT:-}" "$ROUTES" "$MODE" <<'PY'
import pathlib, shutil, sys
from src import clients

src, split, folder_slug, forced, routes, mode = (
    pathlib.Path(sys.argv[1]), pathlib.Path(sys.argv[2]),
    sys.argv[3], sys.argv[4], pathlib.Path(sys.argv[5]), sys.argv[6])

files = sorted(p for p in src.iterdir() if p.suffix in (".txt", ".json"))
groups = {}
skipped = 0


def _content_hashes(client_key):
    """Hashes of what this client already holds. Filenames cannot be trusted for
    identity: a re-exported call arrives under a fresh UUID, and appending a folder
    twice silently doubled a client's corpus, which would quietly skew every rate
    the graph reports."""
    import hashlib
    d = pathlib.Path("data/clients") / client_key / "transcripts"
    seen = set()
    if d.is_dir():
        for q in d.iterdir():
            if q.is_file():
                seen.add(hashlib.sha1(q.read_bytes()).hexdigest())
    return seen


import hashlib

assigned, unknown = [], []
for p in files:
    if forced:
        assigned.append((forced, p))
        continue
    c = clients.detect_client_for_path(p)
    (assigned.append((c.key, p)) if c else unknown.append(p))

mostly_unknown = unknown and len(unknown) >= max(2, len(files) * 0.5)
if mostly_unknown:
    assigned += [(folder_slug, p) for p in unknown]
    unknown = []

# Content-hash dedup only makes sense in APPEND mode, where the goal is "don't
# double the corpus with a re-dropped file." In REPLACE mode the persistent store
# is about to be wiped and rebuilt from exactly what's in this folder — deduping
# against the store being replaced would, whenever content happens to overlap,
# skip the sync entirely and silently leave stale files (or a stale absence of
# recently-removed files) behind instead of actually replacing anything.
if mode == "append":
    _existing = {}
    for key, p in assigned:
        if key not in _existing:
            _existing[key] = _content_hashes(key)
        h = hashlib.sha1(p.read_bytes()).hexdigest()
        if h in _existing[key]:
            skipped += 1
            continue
        _existing[key].add(h)
        groups.setdefault(key, []).append(p)
else:
    for key, p in assigned:
        groups.setdefault(key, []).append(p)

for key, ps in groups.items():
    d = split / key
    d.mkdir(parents=True, exist_ok=True)
    for p in ps:
        shutil.copy2(p, d / p.name)

known = {c.key for c in clients.get_known_clients()}
with routes.open("w") as fh:
    for key, ps in sorted(groups.items(), key=lambda kv: -len(kv[1])):
        fh.write(f"{key}\t{len(ps)}\t{'known' if key in known else 'new'}\n")
if skipped:
    print(f"  \033[2m{skipped} file(s) skipped — identical content already loaded\033[0m")
if unknown:
    print(f"  \033[1;33m{len(unknown)} file(s) NOT loaded\033[0m — could not tell which client "
          f"they belong to:")
    for p in unknown[:5]:
        print(f"      {p.name}")
    if len(unknown) > 5:
        print(f"      … and {len(unknown) - 5} more")
    print("  \033[2mIf these do belong to a client, re-run as: "
          "CLIENT=<key> ./load-transcripts\033[0m")
PY
)

while IFS=$'\t' read -r key n kind; do
  if [ "$kind" = "known" ]; then
    printf '  %s%-22s%s %4s file(s)  %s(existing client)%s\n' "$BOLD" "$key" "$OFF" "$n" "$DIM" "$OFF"
  else
    printf '  %s%-22s%s %4s file(s)  %s(NEW client — matched no known signature)%s\n' \
      "$YELLOW" "$key" "$OFF" "$n" "$DIM" "$OFF"
  fi
done < "$ROUTES"
echo

if [ "$MODE" = "replace" ]; then
  printf '  %sReplacing each client'"'"'s existing transcript set with this load.%s\n' "$DIM" "$OFF"
fi

# --- sync each group into its persistent store — LOAD ONLY, no graph build ---
while IFS=$'\t' read -r key n kind; do
  BEFORE=0
  [ -d "$ENGINE/data/clients/$key/transcripts" ] && \
    BEFORE=$(find "$ENGINE/data/clients/$key/transcripts" -type f | wc -l | tr -d ' ')

  (cd "$ENGINE" && python3 - "$key" "$SPLIT_DIR/$key" "$MODE" <<'PY'
import sys
from pathlib import Path
from run_client import sync_transcripts, _client_by_key_or_new
client = _client_by_key_or_new(sys.argv[1])
sync_transcripts(client, Path(sys.argv[2]), append=(sys.argv[3] == "append"))
PY
)

  AFTER=$(find "$ENGINE/data/clients/$key/transcripts" -type f | wc -l | tr -d ' ')
  printf '  %s✓%s %-22s %s -> %s transcript(s)\n' "$GREEN" "$OFF" "$key" "$BEFORE" "$AFTER"
done < "$ROUTES"

printf '\n  Next: %s./load-prompt%s, then %s./run-pipeline%s\n\n' "$BOLD" "$OFF" "$BOLD" "$OFF"
