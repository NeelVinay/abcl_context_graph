#!/usr/bin/env bash
#
# ONE command: build the context graph from the transcripts on Desktop, then
# improve the latest ABCL prompt in Downloads against it.
#
#   ./demo                                    use the defaults below
#   ./demo ~/Desktop/other_transcripts         different transcripts folder
#   ./demo ~/Desktop/other_transcripts ~/x.raven   and a specific prompt
#
# Defaults:
#   transcripts:  ~/Desktop/ABCL_demo_transcripts
#   prompt:       the most recently modified "ABCL...prompt..." file in ~/Downloads

set -euo pipefail
cd "$(dirname "$0")"

BOLD=$'\033[1m'; CYAN=$'\033[1;36m'; RED=$'\033[1;31m'; OFF=$'\033[0m'
die() { printf '\n%s✗ %s%s\n\n' "$RED" "$1" "$OFF" >&2; exit 1; }

TRANSCRIPTS="${1:-$HOME/Desktop/ABCL_demo_transcripts}"
PROMPT="${2:-}"

if [ -z "$PROMPT" ]; then
  PROMPT=$(python3 - <<'PY'
import pathlib
cands = [p for p in pathlib.Path.home().glob("Downloads/*")
         if p.is_file() and "abcl" in p.name.lower() and "prompt" in p.name.lower()]
print(max(cands, key=lambda p: p.stat().st_mtime)) if cands else print("")
PY
)
  [ -n "$PROMPT" ] || die "no 'ABCL...prompt...' file found in ~/Downloads — pass one explicitly:
      ./demo \"$TRANSCRIPTS\" '/path/to/prompt'"
fi

[ -d "$TRANSCRIPTS" ] || die "transcripts folder not found: $TRANSCRIPTS"
[ -f "$PROMPT" ]      || die "prompt file not found: $PROMPT"

printf '\n%s%s Running the full pipeline, one shot %s%s\n' "$BOLD" "$CYAN" "$OFF" "$OFF"
printf '  transcripts: %s\n' "$TRANSCRIPTS"
printf '  prompt:      %s\n\n' "$PROMPT"

./add-transcripts "$TRANSCRIPTS"
./improve "$PROMPT"
